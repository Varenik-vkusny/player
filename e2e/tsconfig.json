{
  // Тесты тоже проверяются типами. Playwright транспилирует TypeScript
  // без проверки, поэтому до появления этого файла ошибка типа в спеке
  // не ловилась ничем и всплывала бы падением в браузере.
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    // Спеки читают фикстуры и бандл с диска: им нужны типы Node.
    "types": ["node"],
    "paths": {
      "@player/core": ["../packages/core/src/index.ts"],
      "@player/player": ["../packages/player/src/index.ts"],
      "@player/editor": ["../packages/editor/src/index.ts"]
    }
  },
  "include": ["**/*.ts"]
}
