# секреты — никогда не в репозиторий
.env
.env.*
!.env.example

# зависимости
node_modules/
.pnpm-store/
.venv/

# оснастка спайков: выравниватель и его окружение, ставится локально
tools/
.mfa/
MFA/

# сборка
dist/
build/
*.tsbuildinfo
# Спайки собираются в свои каталоги рядом (`dist-a`, `dist-b` у map-stack),
# и `dist/` их НЕ ловит: шаблон совпадает с именем целиком. Сессия 24 чуть
# не унесла в репозиторий 574 КБ пересобираемых артефактов.
dist-*/

# артефакты тестов
test-results/
playwright-report/
blob-report/
coverage/

# крупные артефакты спайков: аудио и записи генерируются локально.
# JSON с результатами измерений НЕ игнорируется — это доказательная база.
spikes/**/*.mp3
spikes/**/*.wav
spikes/**/*.webm
spikes/**/*.TextGrid
spikes/lib/anime.esm.min.js

# артефакты браузерной инспекции
.playwright-mcp/

# ос и редакторы
Thumbs.db
.DS_Store
debug.log
.idea/

# снимок дымового прогона — артефакт, не исходник
scripts/playground-smoke.png

# логи дев-сервера, запущенного вручную
vite*.log
.gstack/

# Рабочее место оркестрации саб-агентов (SDD): черновики, журнал, отчёты
.superpowers/
