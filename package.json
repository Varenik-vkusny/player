{
  "name": "player-workspace",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.29.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check": "pnpm run typecheck && pnpm run test:unit && pnpm run build:player && pnpm run test:e2e",
    "build:player": "vite build --config packages/player/vite.config.ts",
    "typecheck": "tsc -p packages/core/tsconfig.json --noEmit && tsc -p packages/player/tsconfig.json --noEmit && tsc -p packages/editor/tsconfig.json --noEmit && tsc -p apps/playground/tsconfig.json --noEmit && tsc -p e2e/tsconfig.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "dev": "pnpm --filter @player/playground dev",
    "spikes:serve": "node spikes/serve.mjs 5180",
    "spike:clocks": "node spikes/run-clocks.mjs",
    "spike:timeline": "node spikes/run-timeline.mjs",
    "spike:gate-lock": "node spikes/run-gate-lock.mjs",
    "spike:parity": "node spikes/run-parity.mjs",
    "spike:perf": "node spikes/run-perf.mjs",
    "spike:quota": "node spikes/run-quota.mjs",
    "spike:seam": "node spikes/run-seam.mjs",
    "spike:tab-lock": "node spikes/run-tab-lock.mjs",
    "spike:editor-stack": "vite --config spikes/editor-stack/vite.config.mjs",
    "spike:tokens": "node spikes/run-tokens.mjs",
    "spike:transitions": "node spikes/run-transitions.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@scena/react-guides": "^0.28.2",
    "@types/node": "^22.20.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.0",
    "animejs": "^4.5.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-moveable": "^0.56.0",
    "react-selecto": "^1.26.3",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
